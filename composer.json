{
    "name": "lumeweb/php-portal-sdk",
    "description": "PHP port of the LumeWeb Portal Go SDK (account & admin APIs). Client code is generated from the same OpenAPI specs used by the Go SDK (openapitools/openapi-generator) and wrapped behind a thin handwritten layer that centralizes status/error handling.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "lumeweb",
        "portal",
        "sdk",
        "openapi",
        "http",
        "api"
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "guzzlehttp/psr7": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "LumeWeb\\Portal\\Generated\\Account\\": "generated/account/lib/",
            "LumeWeb\\Portal\\Generated\\Admin\\": "generated/admin/lib/",
            "LumeWeb\\Portal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LumeWeb\\Portal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate": "@php scripts/generate.php",
        "test": "phpunit",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
